{
    "name": "laravel-fans/ui-socialite",
    "description": "Automatically generate database, pages, and routes for Laravel Socialite",
    "type": "library",
    "require": {
        "laravel/framework": "^v12.0.0",
        "laravel/socialite": ">=v5.22.0",
        "doctrine/dbal": ">=2.9",
        "phlak/semver": ">=2.0"
    },
    "suggest": {
        "laravel-fans/socialite-providers": "Providers for Laravel Socialite"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Shaun",
            "email": "ShaunTheGeek@outlook.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "LaravelFans\\UiSocialite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "vendor/orchestra/testbench-core/laravel/app/",
            "Database\\Factories\\": "vendor/orchestra/testbench-core/laravel/database/factories/",
            "LaravelFans\\UiSocialite\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "LaravelFans\\UiSocialite\\UiSocialiteServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^v10.0.0",
        "inertiajs/inertia-laravel": "^2.0",
        "squizlabs/php_codesniffer": ">=3.13.2",
        "fakerphp/faker": ">=v1.24.1",
        "phpunit/phpunit": "^12.2.7"
    }
}
